{
  "manifest_version": 3,
  "name": "Nenaleť – ověř podezřelou zprávu",
  "short_name": "Nenaleť",
  "version": "1.2.0",
  "description": "Pravým tlačítkem ověříte podezřelý text, odkaz, obrázek nebo celou stránku. Verdikt a rada, co dělat, se ukáže v postranním panelu.",
  "default_locale": "cs",
  "minimum_chrome_version": "116",
  "permissions": ["contextMenus", "activeTab", "storage", "sidePanel"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Nenaleť – otevřít panel" },
  "side_panel": { "default_path": "panel.html" },
  "options_page": "options.html",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
